# Network interfaces configuration with priority settings

# Ethernet interface (highest priority) - use eth0 instead of end1
auto eth0
iface eth0 inet dhcp
    metric 100
    timeout 5

# WIFI interface (medium priority)
auto wlan0
iface wlan0 inet dhcp
    metric 600
    timeout 5

# EC20-4G interface (lowest priority)
auto ec20
iface ec20 inet dhcp
    metric 1000
    timeout 5
